  "narrative": {
    "northStar": "A paper workspace for conversation",
    "overview": "The conversation reads down one margin. A small speaker name introduces each turn, and a pending question stands out against the paper as a bordered surface. The person can answer where the question appears and still see the message composer below.\n\nThe same paper, ink and teal carry through to every workspace screen and tool. A person can ask Hermes for a review form, try it in the conversation that produced it and pin it there for later. Its fields prepare an editable message. Technical views make their units, scope and available actions legible in the user's language (English or French).",
    "keyCharacteristics": [
      "One reading column for speakers, messages and decisions.",
      "A quiet teal action color shared by text buttons, choices and the microphone.",
      "Native editors for both the next message and the answer to a specific question.",
      "Human-readable labels paired with measurements and their sources."
    ],
    "rules": [
      {
        "name": "The Editable Draft Rule",
        "body": "Dictation inserts or replaces text at the selection in the active editor. Sending takes a separate tap.",
        "section": "components"
      },
      {
        "name": "The Measurement Label Rule",
        "body": "Place the localized measure name directly above the value. Give the value one accessible description containing both the name and value.",
        "section": "components"
      }
    ],
    "dos": [
      "Keep a pending decision in its own conversation, with its choices and answer field together.",
      "Preserve localized action labels when text wraps or the input method is visible.",
      "Keep code and tool output selectable for inspection."
    ],
    "donts": [
      "Don't send a draft when a person dictates or taps a starter.",
      "Don't turn an unavailable measurement into a zero.",
      "Don't treat a recommended answer as permission to act."
    ]
  }
}
