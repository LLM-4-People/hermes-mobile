<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hermes_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_status_private"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_ask"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/hermes_widget_pill"
            android:contentDescription="@string/widget_ask_description"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_ask"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="15sp" />

        <Button
            android:id="@+id/widget_dictate"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/hermes_widget_pill_secondary"
            android:contentDescription="@string/widget_dictate_description"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_dictate"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
