<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dynamic_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hermes_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dynamic_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dynamic_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_title"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dynamic_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_dynamic_item_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/hermes_widget_pill_secondary"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_dynamic_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/hermes_widget_pill_secondary"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_dynamic_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/hermes_widget_pill_secondary"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_dynamic_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/hermes_widget_pill_secondary"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
