<resources>
    <style name="HermesBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Hermes" parent="HermesBase">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:switchStyle">@style/Widget.Hermes.Switch</item>
    </style>
    <style name="Widget.Hermes.Switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:track">@drawable/hermes_switch_track</item>
        <item name="android:thumb">@drawable/hermes_switch_thumb</item>
        <item name="android:trackTint">@null</item>
        <item name="android:thumbTint">@null</item>
    </style>
</resources>
