<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/on_accent" />
                    <size android:width="22dp" android:height="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/surface" />
                    <stroke android:width="2dp" android:color="@color/line_strong" />
                    <size android:width="22dp" android:height="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
